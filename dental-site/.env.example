# ==============================================================================
# Dental Clinic Official Website — Environment Configuration
# ==============================================================================
# Use "development" locally; set "production" in live deployment.
APP_ENV=development
SITE_BASE_URL=http://127.0.0.1:8001

# Isolated SQLite default inside dental-site/data/ (keeps FaceTrack DB untouched).
# For production PostgreSQL: postgresql+psycopg2://user:password@host:5432/dental_db
DENTAL_DATABASE_URL=

# Required in production: generate with `python -c "import secrets; print(secrets.token_urlsafe(48))"`
DENTAL_SECRET_KEY=

# Clinic timezone & contact configuration (replace placeholders with real values)
CLINIC_TIMEZONE=Asia/Phnom_Penh
CLINIC_NOTIFICATION_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
CLINIC_NOTIFY_EMAIL=

# Staff booking inbox (for optional admin requests view; generate Argon2id hash, never plaintext)
CLINIC_ADMIN_USERNAME=
CLINIC_ADMIN_PASSWORD_HASH=

# Form spam rate-limiting (requests per window per client)
RATE_LIMIT_MAX_REQUESTS=6
RATE_LIMIT_WINDOW_SECONDS=600

